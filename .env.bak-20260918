# Copy to .env (gitignored) and fill in. NEVER commit .env.

# Deployer key (hex, with or without 0x prefix)
PRIVATE_KEY=0x6fcb1580127d023f52fd7dd96eb6f0d279e9a5b39231be90b2082a6784219a37

# RPC endpoints (referenced by foundry.toml [rpc_endpoints])
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=

# Only needed if you ever verify (we deploy UNVERIFIED — do not pass --verify)
BASESCAN_API_KEY=

# ── Real Base Sepolia infrastructure (all verified from official docs 2026-09-13) ──
# Uniswap v3 SwapRouter02 (developers.uniswap.org, Base Sepolia):
SWAP_ROUTER=0x94cC0AaC535CCDB3C01d6787D6413C739ae12bc4
# Uniswap v3 NonfungiblePositionManager (for CreateUniV3Pools.s.sol):
NPM=0x27F971cb582BF9E50F397e4d29a5C7A34f11faA2
# Circle CCTP **v1** TokenMessenger (developers.circle.com/cctp/v1) — our interface
# targets v1. Do NOT use TokenMessengerV2 (0x8FE6B999... — different signature):
CCTP_TOKEN_MESSENGER=0x9f3B8679c73C2Fef8b59B4f3444d4e156fb70AA5
# Circle USDC on Base Sepolia. REQUIRED when CCTP_TOKEN_MESSENGER is real (CCTP only
# burns canonical USDC). Get faucet USDC at https://faucet.circle.com. Leave empty to
# deploy the mintable tUSDC mock instead (then also leave CCTP_TOKEN_MESSENGER empty).
REAL_USDC=
# Aerodrome has NO testnet deployment — the Slipstream adapter uses the mock router on
# Sepolia; real-venue testing for it happens via Base mainnet fork tests.

# Filled in after DeployTestnet, consumed by CreateUniV3Pools + seed scripts
FACTORY=0x152411a40db5899f7dc29a252fa9a7959d4236e8
TUSDC=0x75f31b7c00e6282cdcfd7b4124d8ab327be3ab4d
GPUX=0x88abdbfa9e96183fe7b60466954fe700244b48a3
EVRX=0x49c470fdd3ca20feb9c65f9e8a0f610cc6ab41ff
# (NPM is already pre-filled in .env from the template)

COMPTROLLER_1=0x029403d8b0D4533ACD652965490fF1B9dA4211B9
COMPTROLLER_2=0x0962238548ADb3E21434e27A2a6A6fe478aCd25C
